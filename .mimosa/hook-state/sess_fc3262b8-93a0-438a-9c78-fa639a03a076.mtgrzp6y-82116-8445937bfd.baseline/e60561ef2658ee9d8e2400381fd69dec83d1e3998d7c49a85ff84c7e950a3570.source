#!/bin/bash

# 内容真实性整改批处理脚本
# 用于识别和标记潜在的虚假内容

echo "=== 个人生活数据库真实性整改工具 ==="
echo "开始扫描潜在的虚假内容..."

# 检查虚假机构名称模式
echo "1. 检查编造的机构名称..."
grep -r -n -E "(西湖边的|运河文化|科技园精品|深圳湾海景|南宋御街|滨江新区).*咖啡" . --include="*.md" | head -20

echo ""
echo "2. 检查虚假数据模式..."
grep -r -n -E "2026年.*最新|年营业额突破.*亿|市场规模.*亿|.*超过.*家" . --include="*.md" | head -20

echo ""
echo "3. 检查虚假政府数据引用..."
grep -r -n -E "根据.*局的数据|据.*统计.*2026|.*数据显示.*2026" . --include="*.md" | head -20

echo ""
echo "4. 检查虚假时间逻辑..."
grep -r -n -E "截至2026年|2026年现状|未来.*将达" . --include="*.md" | head -20

echo ""
echo "=== 建议整改措施 ==="
echo "1. 删除所有编造的机构名称和地址"
echo "2. 替换为真实存在的知名连锁品牌"
echo "3. 使用真实的统计数据来源"
echo "4. 修正时间表述逻辑"
echo "5. 添加可靠的信息来源标注"

echo ""
echo "=== 推荐的真实数据来源 ==="
echo "- 国家统计局 (stats.gov.cn)"
echo "- 各省市统计局官网"
echo "- 艾瑞咨询、前瞻产业研究院等行业报告"
echo "- 大众点评、美团等用户评价平台"
echo "- 企业官网和公开年报"

echo ""
echo "扫描完成。请根据上述结果进行相应整改。"